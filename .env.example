# Setradar — Environment Variablen
# Kopieren zu .env und Werte eintragen. .env wird NICHT ins Git commited.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
# Backend only. Prefer the independently rotatable Supabase secret key.
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback during migration only; leave empty for new setups.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (Vision für Story-OCR) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Lokaler easyocr-Pre-Filter vor OpenAI. 1 = an (spart OpenAI-Calls),
# 0 = aus (jedes Bild direkt an OpenAI). Auf schwachen/heißen Pis 0 setzen,
# da easyocr dort langsamer ist (Minuten/Bild, Throttling/OOM) als ein API-Call.
OCR_PREFILTER=1

# ── Google Drive (optional, falls Story-Upload zu Drive) ────────────────────
# Pfad zur Service-Account-JSON, relativ zum Repo-Root:
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
DRIVE_FOLDER_ID=

# ── ADB (Instagram-Bot) ─────────────────────────────────────────────────────
# Leer lassen wenn nur 1 Phone verbunden ist
ADB_DEVICE=
