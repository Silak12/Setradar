# Setradar — Environment Variablen
# Kopieren zu .env und Werte eintragen. .env wird NICHT ins Git commited.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── OpenAI (Vision für Story-OCR) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Drive (optional, falls Story-Upload zu Drive) ────────────────────
# Pfad zur Service-Account-JSON, relativ zum Repo-Root:
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
DRIVE_FOLDER_ID=

# ── ADB (Instagram-Bot) ─────────────────────────────────────────────────────
# Leer lassen wenn nur 1 Phone verbunden ist
ADB_DEVICE=
